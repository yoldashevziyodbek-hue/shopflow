# Copy to .env and fill in. NEVER commit .env.

# --- Sampling ---
# Keep all events of users where user_id % SAMPLE_MOD == 0 (~1/SAMPLE_MOD of the users)
SAMPLE_MOD=70

# --- Kafka ---
KAFKA_BOOTSTRAP_HOST=localhost:9092
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092
KAFKA_TOPIC_EVENTS=shop.events

# --- Spark ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- AWS (stage 3) ---
AWS_REGION=your-region
S3_BUCKET=your-bucket-name

# --- Snowflake (stage 4) ---
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SHOPFLOW
