.env
__pycache__/
*.pyc
.venv/
venv/

# data never goes to git
data/raw/*
data/sample/*
!data/raw/.gitkeep
!data/sample/.gitkeep

# dbt / airflow artifacts
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
airflow/logs/
*.log
.DS_Store

# generated by spark jobs — never commit
data/bronze/*
data/silver/*
data/gold/*
data/checkpoints/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/checkpoints/.gitkeep
